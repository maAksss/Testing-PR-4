{
  "info": {
    "name": "Bookstore API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "POST додати книгу",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isbn\": \"978-966-00-0001\",\n  \"title\": \"Python Programming\",\n  \"author\": \"John Doe\",\n  \"description\": \"Підручник\",\n  \"price\": 350.0,\n  \"quantity\": 10\n}"
        }
      }
    },
    {
      "name": "GET усі книги",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
    },
    {
      "name": "GET книга за ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "1"
          ]
        }
      }
    },
    {
      "name": "PUT оновити книгу",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 399.0,\n  \"quantity\": 25,\n  \"description\": \"Нове видання\"\n}"
        }
      }
    },
    {
      "name": "DELETE книга за ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "1"
          ]
        }
      }
    },
    {
      "name": "DELETE книга за ISBN",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/isbn/978-966-00-0001",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "isbn",
            "978-966-00-0001"
          ]
        }
      }
    },
    {
      "name": "POST створити замовлення",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1,\n  \"items\": [\n    {\n      \"bookId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "GET замовлення за ID (підставте Guid)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/00000000-0000-0000-0000-000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "00000000-0000-0000-0000-000000000000"
          ]
        }
      }
    },
    {
      "name": "PUT статус замовлення",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/00000000-0000-0000-0000-000000000000/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "00000000-0000-0000-0000-000000000000",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Shipped\"\n}"
        }
      }
    },
    {
      "name": "GET замовлення клієнта",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customers/1/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers",
            "1",
            "orders"
          ]
        }
      }
    }
  ]
}